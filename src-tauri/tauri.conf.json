{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pluck",
  "version": "../package.json",
  "identifier": "com.soleone.pluck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "label": "menu",
        "title": "Pluck",
        "width": 420,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      },
      {
        "label": "home",
        "title": "Pluck",
        "width": 720,
        "height": 540,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMzcxMUYzNDQ1N0U3MDAKUldRQTUxZEU4eEUzdlAwcDY0U2pHYXFRR3hDSHljbEpNRHg3eGZqZWF3L1Z3VHdqOXNISzJ0Z3UK",
      "endpoints": ["https://github.com/Soleone/pluck/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
